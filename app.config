<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>

  <appSettings>

    <!-- =============================================
         LogDeleter 설정
         ============================================= -->

    <!-- 하위 폴더 전체를 감시할 루트 폴더
         이 폴더의 직계 하위 폴더가 압축/삭제 대상이 됩니다.
         예) C:\Logs 로 설정하면 C:\Logs\App1, C:\Logs\App2 등을 처리합니다. -->
    <add key="RootFolder" value="C:\Logs" />

    <!-- 이 시간(시간 단위) 이전에 수정된 로그를 압축합니다. 기본값: 10 -->
    <add key="CompressAfterHours" value="10" />

    <!-- 이 기간(일 단위) 이전의 파일(압축 파일 포함)을 삭제합니다. 기본값: 14 -->
    <add key="DeleteAfterDays" value="14" />

    <!-- Worker 실행 주기 (분 단위). 기본값: 60 -->
    <add key="WorkerIntervalMinutes" value="60" />

    <!-- 압축 대상 파일 확장자 (콤마로 구분). 기본값: .txt,.log -->
    <add key="LogExtensions" value=".txt,.log" />

    <!-- 삭제 대상 파일 확장자 (콤마로 구분). 기본값: .txt,.log,.zip -->
    <add key="DeletionExtensions" value=".txt,.log,.zip" />

    <!-- 각 하위 폴더 안에서 재귀 탐색 여부. 기본값: true -->
    <add key="SearchSubDirectories" value="true" />

    <!-- LogDeleter 자체 동작 로그(압축/삭제 이력)를 저장할 폴더 -->
    <add key="ActivityLogFolder" value="C:\Logs\LogDeleter" />

  </appSettings>
</configuration>
