{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Information"
      }
    }
  },
  "LogDeleterSettings": {
    "RootFolder": "C:\\Logs",
    "CompressAfterHours": 10,
    "DeleteAfterDays": 14,
    "WorkerIntervalMinutes": 60,
    "LogExtensions": [ ".txt", ".log" ],
    "DeletionExtensions": [ ".txt", ".log", ".zip" ],
    "SearchSubDirectories": true,
    "ActivityLogFolder": "C:\\Logs\\LogDeleter"
  }
}
